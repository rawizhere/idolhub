package templates

templ externalIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-2.5 h-2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
}

// loadMore is the infinite-scroll sentinel; gallery.js observes [data-next-url] and swaps it for the next page.
templ loadMore(nextURL string) {
	if nextURL != "" {
		<div data-next-url={ nextURL } class="load-more col-span-full w-full flex items-center justify-center gap-3 py-6">
			<div class="animate-spin rounded-full h-5 w-5 border-2 border-slate-200 dark:border-zinc-800 border-t-[#ff9900]"></div>
			<button type="button" data-action="load-more" class="text-xs font-semibold text-[#ff9900] hover:underline cursor-pointer">Load more</button>
		</div>
	}
}

templ GalleryGridItem(f GalleryFileData) {
	<a
		class="gallery-item pswp-item group relative block w-full aspect-square overflow-hidden rounded-xl border border-slate-200 dark:border-zinc-800/80 bg-slate-100 dark:bg-zinc-900 shadow-xs hover:border-[#ff9900]/50 transition-colors duration-150 cursor-pointer"
		href={ templ.SafeURL(f.URL) }
		title={ f.Filename }
		data-filename={ f.Filename }
		data-date={ f.Date }
		data-caption={ f.Caption }
		data-source={ f.SourceURL }
		if f.Type == "video" {
			data-pswp-type="video"
		}
	>
		<div
			class="w-full h-full relative overflow-hidden video-preview-tile"
			if f.Type == "video" {
				data-video-src={ f.URL }
			}
		>
			<img src={ f.ThumbnailURL } alt={ f.Filename } loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-200 block"/>
			if f.Type == "video" {
				<div class="absolute inset-0 flex items-center justify-center bg-black/15 group-hover:bg-black/25 transition-all duration-200 pointer-events-none">
					<div class="bg-black/75 text-white p-2.5 rounded-full shadow-md scale-95 group-hover:scale-105 transition-all duration-200 flex items-center justify-center">
						<svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M8 5v14l11-7z"></path></svg>
					</div>
				</div>
			}
			<span class="select-check" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="w-3.5 h-3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
			</span>
		</div>
	</a>
}

templ GalleryGridPage(files []GalleryFileData, nextURL string) {
	for _, f := range files {
		@GalleryGridItem(f)
	}
	@loadMore(nextURL)
}

templ GalleryPostCard(post GalleryPostData) {
	<div class="post-card flex flex-col gap-3.5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-4 shadow-xs">
		<div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800/50 pb-2.5">
			<span class="text-xs font-semibold text-slate-500 dark:text-zinc-400 font-mono flex items-center gap-1.5">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
				{ post.DateLabel }
			</span>
			if post.SourceURL != "" {
				<a
					href={ templ.SafeURL(post.SourceURL) }
					target="_blank"
					rel="noopener noreferrer"
					class="text-xs font-medium text-[#ff9900] hover:text-[#e68a00] font-mono bg-slate-100 dark:bg-zinc-950 hover:bg-[#ff9900]/10 px-2 py-0.5 rounded border border-slate-200 dark:border-zinc-800/50 transition-all flex items-center gap-1"
				>
					#{ post.TweetIDSuffix }
					@externalIcon()
				</a>
			} else if post.TweetIDSuffix != "" {
				<span class="text-xs font-mono text-slate-400 dark:text-zinc-500">#{ post.TweetIDSuffix }</span>
			}
		</div>
		if post.CleanText != "" {
			<p class="text-sm text-slate-900 dark:text-zinc-100 leading-relaxed font-normal whitespace-pre-wrap break-words">{ post.CleanText }</p>
		}
		if len(post.LocalFiles) > 0 {
			<div class="flex gap-2 flex-wrap mt-1">
				for _, file := range post.LocalFiles {
					<a
						href={ templ.SafeURL(file.URL) }
						class="pswp-item group relative w-32 h-32 rounded-lg overflow-hidden border border-slate-200 dark:border-zinc-800 bg-slate-50 dark:bg-zinc-950 hover:border-[#ff9900]/50 hover:scale-105 transition-all duration-150 flex-shrink-0 flex items-center justify-center cursor-pointer"
						data-filename={ file.Filename }
						data-date={ post.DateLabel }
						data-caption={ post.CleanText }
						data-source={ post.SourceURL }
						if file.IsVideo {
							data-pswp-type="video"
						}
					>
						<img src={ file.ThumbnailURL } alt={ file.Filename } loading="lazy" decoding="async" class="w-full h-full object-cover"/>
						if file.IsVideo {
							<div class="absolute inset-0 flex items-center justify-center bg-black/10">
								<div class="bg-white dark:bg-zinc-900/95 text-slate-900 dark:text-zinc-100 p-1.5 rounded-full shadow-xs">
									<svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3"><path d="M8 5v14l11-7z"></path></svg>
								</div>
							</div>
						}
					</a>
				}
			</div>
		}
		for _, yt := range post.YoutubeURLs {
			<button
				type="button"
				class="youtube-preview group/yt relative block w-full max-w-md aspect-video rounded-xl overflow-hidden border border-slate-200 dark:border-zinc-800 bg-slate-100 dark:bg-zinc-800 cursor-pointer shadow-xs mt-2 hover:shadow-md hover:border-[#ff9900]/50 transition-all duration-200 text-left"
				data-action="youtube-play"
				data-youtube-id={ yt.VideoID }
				aria-label={ "Play YouTube video " + yt.VideoID }
			>
				<img src={ "https://img.youtube.com/vi/" + yt.VideoID + "/hqdefault.jpg" } alt={ "YouTube thumbnail for video " + yt.VideoID } loading="lazy" decoding="async" class="w-full h-full object-cover"/>
				<div class="absolute inset-0 flex items-center justify-center bg-black/15 group-hover/yt:bg-black/30 transition-all duration-200 pointer-events-none">
					<div class="bg-rose-600 group-hover/yt:bg-rose-700 text-white px-4 py-2 rounded-xl shadow-md flex items-center gap-2 font-bold text-xs uppercase tracking-wider transition-all duration-200">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.508a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.508 9.388.508 9.388.508s7.518 0 9.388-.508a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>
						Play YouTube Video
					</div>
				</div>
				<span class="absolute bottom-2.5 right-2.5 text-xs font-bold tracking-wide uppercase px-2 py-0.5 bg-rose-600/90 text-white rounded flex items-center gap-1">YouTube</span>
			</button>
		}
	</div>
}

templ GalleryPostsPage(posts []GalleryPostData, nextURL string) {
	for _, post := range posts {
		@GalleryPostCard(post)
	}
	@loadMore(nextURL)
}
